@model ProductsValidation.Models.User

@{
    ViewData["Title"] = "Create";
}

<h1 class="reference-heading">Create</h1>

<div class="row">
    <div class="col-12 col-md-8 col-lg-6">
        <form class="editor-form p-4 mb-4" asp-action="Create" method="post"
              asp-route-Id="@Model.Id" asp-route-Name="@Model.Name"
              asp-route-Email="@Model.Email" asp-route-Role="@Model.Role">
            <div class="form-group mb-4">
                <label asp-for="Id" class="control-label font-weight-bold"></label>
                <input asp-for="Id" class="form-control" readonly />
            </div>
            <div class="form-group mb-4">
                <label asp-for="Name" class="control-label font-weight-bold"></label>
                <input asp-for="Name" class="form-control" readonly />
            </div>
            <div class="form-group mb-4">
                <label asp-for="Email" class="control-label font-weight-bold"></label>
                <input asp-for="Email" class="form-control" readonly />
            </div>
            <div class="form-group mb-4">
                <label asp-for="Role" class="control-label font-weight-bold"></label>
                <input asp-for="Role" class="form-control" readonly />
            </div>
            <input type="submit" value="Save" class="btn btn-primary" />
        </form>
    </div>
</div>

<a asp-action="Index">Back to List</a>
