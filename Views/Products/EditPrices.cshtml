@model List<ProductsValidation.Models.Product>

@{
    ViewData["Title"] = "Edit";
}

<h1 class="reference-heading">Edit</h1>

<h4>Product</h4>
<hr />
<div class="row">
    <div class="col-12">
        <form class="editor-form prices-form p-4 mb-4" asp-action="EditPrices" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row">
            @for(int i = 0; i < Model.Count; i++)
            {    
                <div class="col-12 col-md-6 col-lg-4 mb-4">
                <div class="price-product">
                <div class="form-group mb-4">
                    <label asp-for="@Model[i].Id" class="control-label font-weight-bold"></label>
                    <input asp-for="@Model[i].Id" readonly class="form-control" />
                </div>
                <div class="form-group mb-4">
                    <label asp-for="@Model[i].Name" class="control-label font-weight-bold"></label>
                    <input asp-for="@Model[i].Name" readonly class="form-control" />
                </div>
                <div class="form-group mb-4">
                    <label asp-for="@Model[i].Price" class="control-label font-weight-bold"></label>
                    <input asp-for="@Model[i].Price" class="form-control" />
                    <span asp-validation-for="@Model[i].Price" class="text-danger"></span>
                </div>
                </div>
                </div>
            }
            </div>
            <div class="form-group mb-4">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>
