@model List<ProductsValidation.Models.Product>

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Product</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="EditPrices" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            @for(int i = 0; i < Model.Count; i++)
            {    
                <div class="form-group">
                    <label asp-for="@Model[i].Id" class="control-label"></label>
                    <input asp-for="@Model[i].Id" readonly class="form-control" />
                </div>
                <div class="form-group">
                    <label asp-for="@Model[i].Name" class="control-label"></label>
                    <input asp-for="@Model[i].Name" readonly class="form-control" />
                </div>
                <div class="form-group">
                    <label asp-for="@Model[i].Price" class="control-label"></label>
                    <input asp-for="@Model[i].Price" class="form-control" />
                    <span asp-validation-for="@Model[i].Price" class="text-danger"></span>
                </div>
                <br />
                <br />
            }
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

