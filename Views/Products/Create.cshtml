@model ProductsValidation.Models.Product

@{
    ViewData["Title"] = "Create";
}

<h1 class="reference-heading">Create</h1>

<h4>Product</h4>
<hr />
<div class="row">
    <div class="col-12 col-md-8 col-lg-6">
        <form class="editor-form p-4 mb-4" asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group mb-4">
                <label asp-for="Id" class="control-label font-weight-bold"></label>
                <input asp-for="Id" class="form-control" />
                <span asp-validation-for="Id" class="text-danger"></span>
            </div>
            <div class="form-group mb-4">
                <label asp-for="Type" class="control-label font-weight-bold"></label>
                <select asp-for="Type"
                        asp-items="Html.GetEnumSelectList<ProductsValidation.Models.Product.Category>()"
                        class="form-control">
                </select>
                <span asp-validation-for="Type" class="text-danger"></span>
            </div>
            <div class="form-group mb-4">
                <label asp-for="Name" class="control-label font-weight-bold"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group mb-4">
                <label asp-for="Description" class="control-label font-weight-bold"></label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group mb-4">
                <label asp-for="Price" class="control-label font-weight-bold"></label>
                <input asp-for="Price" class="form-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
            <div class="form-group mb-4">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>
